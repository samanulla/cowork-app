# ---------- Core ----------
FLASK_ENV=development
SECRET_KEY=change-me-to-a-long-random-string
APP_NAME=CoWorkHub
APP_BASE_URL=http://localhost:5000
TIMEZONE=Asia/Kolkata

# ---------- Database (PostgreSQL) ----------
# Local Postgres (docker-compose spins one up on 5432):
DATABASE_URL=postgresql+psycopg2://coworkhub:coworkhub@localhost:5432/coworkhub
# AWS RDS example:
# DATABASE_URL=postgresql+psycopg2://coworkhub:${DB_PASSWORD}@coworkhub-prod.xxxx.us-east-1.rds.amazonaws.com:5432/coworkhub?sslmode=require

# ---------- Storage ----------
# Backends: local | s3 | azure_blob
STORAGE_BACKEND=local
LOCAL_STORAGE_DIR=./var/uploads

# AWS S3
AWS_REGION=us-east-1
AWS_S3_BUCKET=
AWS_S3_PREFIX=documents/
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Signed URL TTL (seconds)
AWS_S3_URL_TTL=3600

# Azure Blob (used when STORAGE_BACKEND=azure_blob)
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER=documents

# ---------- Email ----------
MAIL_SERVER=localhost
MAIL_PORT=1025
MAIL_USE_TLS=false
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=no-reply@coworkhub.io

# ---------- Booking rules ----------
BOOKING_MIN_ADVANCE_MINUTES=15
BOOKING_MAX_ADVANCE_DAYS=60
BOOKING_CANCEL_WINDOW_MINUTES=60
DEFAULT_ROOM_SLOT_MINUTES=30

# ---------- Super admin bootstrap (used by `flask seed-demo`) ----------
BOOTSTRAP_ADMIN_EMAIL=admin@coworkhub.io
BOOTSTRAP_ADMIN_PASSWORD=ChangeMe123!
